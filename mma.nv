
gpu layout<float,m,p,smem> layout_bf16_layout_bf16_mma(
						layout<bf16, m, n> x, layout<bf16, p, n> y)

	var smem_a = layout<bf16,64,16,smem>()
	var smem_b = layout<bf16,64,16,smem>()
	var smem_out = layout<float,64,128,smem>()

	float[128] c
	for i=0, i<128
		c[i] = 0

	for i=0, i<4
		cp_async16(smem_a offby i*256+lane*8,
				   x offby i*256+lane*8)
	for i=0, i<4
		cp_async16(smem_b offby i*256+lane*8,
				   y offby i*256+lane*8)

	cp_commit_group()
	cp_wait_group(0)


	syncthreads()

	int[16] a
	int[16] b


	for i=0, i<4
		int row = i*16+lane%16
		int col = lane//16*8
		ldmatrix_x4(
				a offby i*4,
			smem_a offby (
				row*16 + col
			))

	for i=0, i<8
		int row = i*8+lane%8
		int col = ((lane//8)%2)*8
		ldmatrix_x2(
				b offby i*2,
			smem_b offby (
				row*16 + col
			))


	for i=0, i<4
		for j=0,j<8
			mma_16x8x16(c offby (i*8+j)*4,
						a offby i*4,
						b offby j*2)

	syncthreads()


	for i=0,i<4
		for j=0,j<8
			for k=0, k<4
				int lane_off = lane//4*64+lane%4*2 
				smem_out[
					i*64*16+
					lane_off+
					k//2*512 +
					j*8 + k%2
				] = c[(i*8+j)*4+k]

	syncthreads()

	return smem_out
