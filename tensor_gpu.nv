
def int array_int_prod(array<int> v)
	int prod = 1
	for i in v
		prod = prod*i
	return prod

class optim_info
	array<gpu_tensor> params
	ctor()
		0
	def float register(gpu_tensor x)
		self.params.append(x)

class gpu_tensor
	array<int> dims
	int dims_prod, type
	float_pp ptr, d
	bf16_pp ptr_bf16, d_bf16
	bool is_weight, shall_prop
	array<BackNode> reqs

	ctor(array<int> dims, str init)
		self.dims = dims
		self.dims_prod = array_int_prod(self.dims)
		self.is_weight = false
		self.shall_prop = false
		self.d = nil
		self.type = float_t
		if init=="xavu"
			self.ptr = xavu_cuda(self.dims_prod, dims[0], dims[1])
			self.type = float_t
		if init=="conv"
			#self.ptr = xavu_cuda(self.dims_prod, dims[0]*dims[-1]*dims[-1], dims[1]*dims[-1]*dims[-1])
			self.ptr = xavu_conv(dims[0], dims[1], dims[2], dims[3], self.dims_prod)
			self.type = float_t
		if init=="randu"
			self.ptr = randu_cuda(self.dims_prod)
			self.type = float_t
		if init=="zeros"
			self.ptr = zeros_cuda(self.dims_prod)
			self.type = float_t
		if init=="ones"
			self.ptr = ones_cuda(self.dims_prod)
			self.type = float_t
		if init=="randu_bf16"
			self.ptr_bf16 = randu_bf16_cuda(self.dims_prod)
			self.type = bf16_t
		if init=="zeros_bf16"
			self.ptr_bf16 = zeros_bf16_cuda(self.dims_prod)
			self.type = bf16_t
		if init=="none"
			0

	def float_pp getd()
		if !self.d
			self.d = zeros_cuda_pool(self.dims_prod)
		if self.is_weight
			$optim_info.register(self)
		return self.d

	def float as_weight()
		self.is_weight = true
		self.shall_prop = true

	def float print()
		print(" ")
		self.print_dims()
		if self.type==float_t
			var z = self.ptr.cpu(self.dims_prod)
			z.print(self.dims)
		if self.type==bf16_t
			var z = self.ptr_bf16.cpu(self.dims_prod)
			z.print(self.dims)
			0
		self.print_dims()
		print(" ")
	def float printd()
		print(" ")
		self.print_dims()
		var z = self.d.cpu(self.dims_prod)
		z.print(self.dims)
		self.print_dims()
		print(" ")

	def void save(str path)
		if self.type==bf16_t
			#self.ptr_bf16.save(self.dims_prod, path)
			self.ptr_bf16.cpu(self.dims_prod).save(self.dims_prod, path)
		else
			print("Save float")

	def float print_dims()
		self.dims.print()
	def float shape()
		self.dims.print()

	def int load_img(str path)
		float_cpu img
		array<int> img_dims
		img, img_dims = load_image(path)
		self.dims = img_dims
		self.dims_prod = img_dims.prod()
		self.ptr = img.cuda(img_dims.prod())

	def gpu_tensor view(array<int> dims)
		if self.dims_prod != dims.prod()
			int prod=1
			bool has_neg=false
			for i in dims
				if i==-1
					has_neg=true
				else
					prod = prod * i
			if has_neg
				array<int> new_dims
				for i in dims
					if i==-1
						new_dims.append(self.dims_prod//prod)
					else
						new_dims.append(i)
				dims = new_dims
			else
				print("Incorrect view dims.")
				_quit_()
		gpu_tensor view_gpu_tensor = new gpu_tensor(dims, "none")
		view_gpu_tensor.ptr = self.ptr
		view_gpu_tensor.d = self.d
		view_gpu_tensor.shall_prop = self.shall_prop
		return view_gpu_tensor



def gpu_tensor image_gpu_tensor(str path)
	float_cpu img
	array<int> img_dims
	#print("open img ", path)
	img, img_dims = load_image(path)
	gpu_tensor ret = new gpu_tensor(img_dims, "none")
	ret.ptr = img.cuda(img_dims.prod())
	return ret

